<Window x:Class="OnePlusBudsPro3.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Width="320" Height="220"
        Background="#15171C" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">

    <Border Background="#1E2128" CornerRadius="14" Margin="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag">
                <TextBlock Text="About" Foreground="#8A90A0" FontSize="12"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="46"
                        Foreground="#8A90A0" Background="Transparent" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="OnClose">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2A2E38"/>
                                    <Setter Property="Foreground" Value="#E6E8EE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Content -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="24,0,24,16">
                <Image Source="app.ico" Width="40" Height="40" Margin="0,0,0,12"/>
                <TextBlock Text="OnePlus Buds Pro 3 Controller" Foreground="#E6E8EE"
                           FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="by nic0manz" Foreground="#8A90A0"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                <TextBlock HorizontalAlignment="Center">
                    <Hyperlink x:Name="RepoLink" RequestNavigate="OnNavigate"
                               NavigateUri="https://github.com/nic0manz/oneplus_buds3_pro_dotnet">
                        <TextBlock Text="github.com/nic0manz/oneplus_buds3_pro_dotnet"
                                   Foreground="#4C77F0" FontSize="11"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
