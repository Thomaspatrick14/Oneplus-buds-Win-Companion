<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>OnePlusBuds</AssemblyName>
    <AssemblyTitle>OnePlus Buds</AssemblyTitle>
    <RootNamespace>OnePlusBuds4</RootNamespace>
    <Title>OnePlus Buds</Title>
    <Product>OnePlus Buds</Product>
    <Description>Windows companion controller for OnePlus Buds (Buds 4 &amp; Buds Pro 3)</Description>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Authors>Thomaspatrick14</Authors>
    <RepositoryUrl>https://github.com/Thomaspatrick14/Oneplus-buds-Win-Companion</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico"/>
    <EmbeddedResource Include="app.ico"/>
  </ItemGroup>

</Project>
