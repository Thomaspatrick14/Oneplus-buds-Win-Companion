<Window x:Class="OnePlusBuds4.PacketLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnePlus Buds — Live Packet Monitor" Width="720" Height="480"
        MinWidth="500" MinHeight="320"
        Background="#15171C" WindowStyle="None"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" Icon="app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="LogBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Background" Value="#2A2E38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A4150"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4C77F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E2128" CornerRadius="12" Margin="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="📟" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Live Bluetooth RFCOMM Packet Monitor" Foreground="#E6E8EE" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="— OnePlus Buds" Foreground="#8A90A0" FontSize="12"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="42" Height="36"
                        Foreground="#8A90A0" Background="Transparent" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="OnClose">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="14,0,14,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="CopyBtn" Content="📋 Copy All" Style="{StaticResource LogBtn}"
                            Margin="0,0,8,0" Click="OnCopyAll"/>
                    <Button x:Name="ClearBtn" Content="🗑 Clear" Style="{StaticResource LogBtn}"
                            Margin="0,0,12,0" Click="OnClear"/>
                    <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True"
                              Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="PacketCountText" Text="Packets: 0" Foreground="#8A90A0" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- Packet log content -->
            <Border Grid.Row="2" Background="#14161B" CornerRadius="8" Margin="14,0,14,10"
                    BorderBrush="#2A2E38" BorderThickness="1">
                <TextBox x:Name="LogBox" Background="Transparent" Foreground="#E6E8EE"
                         FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="12"
                         BorderThickness="0" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Padding="10" SelectionBrush="#4C77F0"/>
            </Border>

            <!-- Probe & Send Bar -->
            <Grid Grid.Row="3" Margin="14,0,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HexInputBox" Height="30" Background="#14161B" Foreground="#E6E8EE"
                         BorderBrush="#2A2E38" BorderThickness="1" Padding="8,4"
                         FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                         VerticalContentAlignment="Center"
                         Text="AA 07 00 00 01 01 00 00 00"
                         ToolTip="Type hex bytes to send (e.g. AA 07 00 00 01 01 00 00 00)"/>
                <Button Grid.Column="1" Content="Send Hex" Style="{StaticResource LogBtn}"
                        Margin="8,0,0,0" Height="30" Click="OnSendHex"/>
                <Button x:Name="ProbeBtn" Grid.Column="2" Content="🔍 Probe Features" Style="{StaticResource LogBtn}"
                        Margin="8,0,0,0" Height="30" Click="OnProbeFeatures"
                        ToolTip="Scan function codes 0x01..0x35 and feature switches to discover all supported earbud features"/>
            </Grid>
        </Grid>
    </Border>
</Window>

