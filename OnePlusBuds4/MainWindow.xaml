<Window x:Class="OnePlusBuds4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OnePlus Buds" Height="760" Width="440" MinHeight="500"
        Background="#15171C" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" ResizeMode="CanResize"
        WindowStyle="None" Icon="app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1E2128"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A90A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
        </Style>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Background" Value="#2A2E38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A4150"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4C77F0"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="sel">
                                <Setter TargetName="b" Property="Background" Value="#4C77F0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Softer highlight: the level Auto is currently applying -->
                            <Trigger Property="Tag" Value="sub">
                                <Setter TargetName="b" Property="Background" Value="#2E3A63"/>
                                <Setter Property="Foreground" Value="#C7D0E6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="#23262E"/>
                                <Setter Property="Foreground" Value="#4A4F5A"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <!-- Auto-off because the earbuds aren't worn (wins over disabled) -->
                            <Trigger Property="Tag" Value="auto">
                                <Setter TargetName="b" Property="Background" Value="#D8C24A"/>
                                <Setter Property="Foreground" Value="#15171C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chrome button (minimize / close) -->
        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#8A90A0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2E38"/>
                                <Setter Property="Foreground" Value="#E6E8EE"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="close">
                                <!-- close button hover is red -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Background" Value="#2A2E38"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <!-- Full-area toggle that opens/closes the dropdown -->
                            <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                Background="{TemplateBinding Background}"
                                IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsDropDownOpen, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="#3A4150" BorderThickness="1" CornerRadius="8"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Text, UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{TemplateBinding Foreground}"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="Hidden"/>
                            <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" IsHitTestVisible="False"
                                  Fill="#8A90A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False" Focusable="False">
                                <Border Background="#2A2E38" BorderBrush="#3A4150" BorderThickness="1"
                                        Margin="0,0,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E6E8EE"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,2">
                                        <ContentPresenter Margin="6,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#3A4150"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#4C77F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Background" Value="#2A2E38"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#E6E8EE"/>
            <Setter Property="SelectionBrush" Value="#4C77F0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Slider -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#4C77F0" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="#4C77F0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#3A4150" Height="4" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/Off toggle pill -->
        <Style x:Key="TogglePill" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#E6E8EE"/>
            <Setter Property="Background" Value="#2A2E38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock x:Name="t" Text="OFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4C77F0"/>
                                <Setter TargetName="t" Property="Text" Value="ON"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="#15171C" MouseLeftButtonDown="OnTitleBarDrag">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Source="app.ico" Width="16" Height="16" Margin="12,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="OnePlus Buds" Foreground="#8A90A0" FontSize="12"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="📟 Log" Width="56" Style="{StaticResource ChromeBtn}"
                    Click="OnOpenLog" ToolTip="Open Live Bluetooth Packet Monitor"/>
            <Button Grid.Column="3" Content="?" Style="{StaticResource ChromeBtn}"
                    Click="OnAbout" ToolTip="About"/>
            <Button Grid.Column="4" Content="─" Style="{StaticResource ChromeBtn}"
                    Click="OnMinimize" ToolTip="Minimize"/>
            <Button Grid.Column="5" Content="✕" Style="{StaticResource ChromeBtn}"
                    Click="OnClose" ToolTip="Close"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="18,10,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Device" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceCombo" Grid.Column="0" Height="34" IsEditable="True"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnDeviceSelectionChanged"
                                  ToolTip="Pick a paired device, or type/paste a MAC"/>
                        <Button x:Name="RefreshBtn" Grid.Column="1" Content="⟳" Width="38" Height="34"
                                Margin="6,0,0,0" Style="{StaticResource Pill}" Click="OnRefreshDevices"/>
                        <Button x:Name="ConnectBtn" Grid.Column="2" Content="Connect" Width="84" Height="34"
                                Margin="6,0,0,0" Style="{StaticResource Pill}" Click="OnConnectClick"/>
                    </Grid>
                    <Grid Margin="2,10,0,0">
                        <TextBlock x:Name="BatteryText" Text="Battery: —" Foreground="#9AA0B0" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox x:Name="StartupCheck" Content="Start with Windows" HorizontalAlignment="Right"
                                  Foreground="#8A90A0" FontSize="11" VerticalAlignment="Center" Cursor="Hand"
                                  Click="OnStartupCheckClick" ToolTip="Launch minimized to system tray when Windows starts"/>
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="NOISE CONTROL" Style="{StaticResource Header}"/>
                            <TextBlock x:Name="WornText" Text="" HorizontalAlignment="Right"
                                       Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Buds 4 Noise Control Panel -->
                        <StackPanel x:Name="NoisePanelBuds4">
                            <!-- 4 Main Modes: Noise Cancellation, Adaptive, Transparency, Off -->
                            <UniformGrid Columns="4">
                                <Button x:Name="AncBtn" Style="{StaticResource Pill}" Click="OnAnc" ToolTip="Noise Cancellation">
                                    <TextBlock Text="Noise Cancellation" TextWrapping="Wrap" TextAlignment="Center"
                                               FontSize="10.5" LineHeight="12"/>
                                </Button>
                                <Button x:Name="AdaptiveBtn" Content="Adaptive" FontSize="11" Style="{StaticResource Pill}" Click="OnAdaptive" ToolTip="Adaptive"/>
                                <Button x:Name="TransBtn" Content="Transparency" FontSize="11" Style="{StaticResource Pill}" Click="OnTrans" ToolTip="Transparency"/>
                                <Button x:Name="OffBtn" Content="Off" FontSize="12" Style="{StaticResource Pill}" Click="OnOff" ToolTip="Off"/>
                            </UniformGrid>
                            <!-- Noise Cancellation Levels: High, Moderate, Low, Auto -->
                            <UniformGrid x:Name="AncLevelsGrid" Columns="4" Margin="0,4,0,0" Visibility="Collapsed">
                                <Button x:Name="HighBtn" Content="High" FontSize="11" Style="{StaticResource Pill}" Click="OnHigh"/>
                                <Button x:Name="MidBtn" Content="Moderate" FontSize="11" Style="{StaticResource Pill}" Click="OnMid"/>
                                <Button x:Name="LowBtn" Content="Low" FontSize="11" Style="{StaticResource Pill}" Click="OnLow"/>
                                <Button x:Name="AutoBtn" Content="Auto" FontSize="11" Style="{StaticResource Pill}" Click="OnAuto"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Buds Pro 3 Noise Control Panel (Nico's Original) -->
                        <StackPanel x:Name="NoisePanelPro3" Visibility="Collapsed">
                            <UniformGrid Columns="3">
                                <Button x:Name="AncBtnPro3" Content="ANC" Style="{StaticResource Pill}" Click="OnAncPro3"/>
                                <Button x:Name="TransBtnPro3" Content="Transparency" Style="{StaticResource Pill}" Click="OnTransPro3"/>
                                <Button x:Name="OffBtnPro3" Content="Off" Style="{StaticResource Pill}" Click="OnOffPro3"/>
                            </UniformGrid>
                            <UniformGrid Columns="4" Margin="0,4,0,0">
                                <Button x:Name="HighBtnPro3" Content="High" FontSize="11" Style="{StaticResource Pill}" Click="OnHighPro3"/>
                                <Button x:Name="MidBtnPro3" Content="Mid" FontSize="11" Style="{StaticResource Pill}" Click="OnMidPro3"/>
                                <Button x:Name="LowBtnPro3" Content="Low" FontSize="11" Style="{StaticResource Pill}" Click="OnLowPro3"/>
                                <Button x:Name="AutoBtnPro3" Content="Auto" FontSize="11" Style="{StaticResource Pill}" Click="OnAutoPro3"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="EQ — SOUND MASTER" Style="{StaticResource Header}"/>
                        <!-- Buds 4 EQ Presets -->
                        <UniformGrid x:Name="EqPanelBuds4" Columns="3">
                            <Button x:Name="EqBalancedBtn" Content="Balanced" Style="{StaticResource Pill}" Click="OnEqBalanced"/>
                            <Button x:Name="EqVocalsBtn" Content="Clear Vocals" Style="{StaticResource Pill}" Click="OnEqVocals"/>
                            <Button x:Name="EqBassBtn" Content="Bass" Style="{StaticResource Pill}" Click="OnEqBass"/>
                        </UniformGrid>
                        <!-- Buds Pro 3 EQ Presets (Nico's Original) -->
                        <UniformGrid x:Name="EqPanelPro3" Columns="3" Visibility="Collapsed">
                            <Button x:Name="EqBalancedBtnPro3" Content="Balanced" Style="{StaticResource Pill}" Click="OnEqBalancedPro3"/>
                            <Button x:Name="EqBoldBtnPro3" Content="Bold" Style="{StaticResource Pill}" Click="OnEqBoldPro3"/>
                            <Button x:Name="EqSerenadeBtnPro3" Content="Serenade" Style="{StaticResource Pill}" Click="OnEqSerenadePro3"/>
                            <Button x:Name="EqBassBtnPro3" Content="Bass" Style="{StaticResource Pill}" Click="OnEqBassPro3"/>
                            <Button x:Name="EqDynBtnPro3" Content="DynAudio" Style="{StaticResource Pill}" Click="OnEqDynPro3"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="BASSWAVE™" Style="{StaticResource Header}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="BassValue" Text="0" Foreground="#4C77F0" FontWeight="Bold"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ToggleButton x:Name="BassToggle" Style="{StaticResource TogglePill}"
                                              Click="OnBassToggle"/>
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="BassSlider" Minimum="-5" Maximum="5" Value="0" Visibility="Collapsed"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="OnBassChanged" Margin="2,10,2,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="CustomEqPanel">
                        <TextBlock Text="CUSTOM EQ" Style="{StaticResource Header}"/>
                        <TextBox x:Name="EqNameBox" Text="My EQ" Height="30" Margin="2,0,2,8"
                                 VerticalContentAlignment="Center"/>
                        <StackPanel x:Name="BandRows"/>
                        <Button x:Name="ApplyEqBtn" Content="Create / Apply Custom EQ" Style="{StaticResource Pill}"
                                Margin="4,8,4,2" Click="OnApplyCustomEq"/>
                        <Grid Margin="2,6,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Slot" Foreground="#9AA0B0" FontSize="12"
                                       VerticalAlignment="Center" Margin="2,0,8,0"/>
                            <ComboBox x:Name="SlotCombo" Grid.Column="1" Width="110" Height="32"
                                       VerticalContentAlignment="Center" SelectedIndex="0"/>
                            <Button Grid.Column="2" Content="Select" Style="{StaticResource Pill}"
                                    Margin="8,0,4,0" Click="OnSelectEq"/>
                            <Button Grid.Column="3" Content="Delete" Width="80" Style="{StaticResource Pill}"
                                    Click="OnDeleteEq"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="EarbudControlsCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="EARBUD CONTROLS" Style="{StaticResource Header}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <!-- Left / Right Selector Pills -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="GestureLeftBtn" Content="Left" Width="56" Height="28" FontSize="11"
                                        Style="{StaticResource Pill}" Margin="0,0,4,0" Tag="sel" Click="OnGestureLeftTab"/>
                                <Button x:Name="GestureRightBtn" Content="Right" Width="56" Height="28" FontSize="11"
                                        Style="{StaticResource Pill}" Margin="0" Click="OnGestureRightTab"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="WHEN NOT ON A CALL" Foreground="#6A7080" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>

                        <!-- Single Tap -->
                        <Grid Margin="2,3,2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Single-tap" Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SingleTapCombo" Grid.Column="1" Height="30" SelectionChanged="OnGestureComboChanged"/>
                        </Grid>

                        <!-- Double Tap -->
                        <Grid Margin="2,3,2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Double-tap" Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DoubleTapCombo" Grid.Column="1" Height="30" SelectionChanged="OnGestureComboChanged"/>
                        </Grid>

                        <!-- Triple Tap -->
                        <Grid Margin="2,3,2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Triple-tap" Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TripleTapCombo" Grid.Column="1" Height="30" SelectionChanged="OnGestureComboChanged"/>
                        </Grid>

                        <!-- Slide -->
                        <Grid Margin="2,3,2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Slide" Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SlideCombo" Grid.Column="1" Height="30" SelectionChanged="OnGestureComboChanged"/>
                        </Grid>

                        <!-- Touch & Hold -->
                        <Grid Margin="2,3,2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Touch &amp; hold" Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TouchHoldCombo" Grid.Column="1" Height="30" SelectionChanged="OnGestureComboChanged"/>
                        </Grid>

                        <TextBlock Text="WHEN ON A CALL" Foreground="#6A7080" FontSize="10" FontWeight="SemiBold" Margin="2,10,0,6"/>

                        <!-- Double Tap Call -->
                        <Grid Margin="2,3,2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Double-tap" Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CallDoubleTapCombo" Grid.Column="1" Height="30" SelectionChanged="OnGestureComboChanged"/>
                        </Grid>

                        <!-- Long Touch & Hold Call -->
                        <Grid Margin="2,3,2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Long touch &amp; hold" Foreground="#9AA0B0" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CallTouchHoldCombo" Grid.Column="1" Height="30" SelectionChanged="OnGestureComboChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#1E2128" CornerRadius="10" Padding="8,4">
                <TextBox x:Name="StatusText" Text="Connecting…" Foreground="#9AA0B0" FontSize="12"
                         Background="Transparent" BorderThickness="0" IsReadOnly="True"
                         TextWrapping="NoWrap" VerticalAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         CaretBrush="Transparent"/>
            </Border>
        </Grid>
    </Grid>
</Window>
